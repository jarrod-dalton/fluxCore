# order columns: GEOID, county_geoid, adiquint, ruca3, m20..m85, f20..f85
relocate(ADI, adiquint, ruca3, .after = county_geoid) %>%
arrange(GEOID)
tract_wide
state_names  <- c("Ohio")
county_names <- list(
Ohio    = c("Cuyahoga","Lake","Geauga","Summit","Medina","Lorain","Portage",
"Ashtabula","Trumbull","Mahoning","Stark","Wayne","Ashland","Huron","Erie"),
Florida = c("Brevard","Indian River","St. Lucie","Martin","Palm Beach","Broward")
)
acs_year    <- 2023
survey      <- "acs5"
# --------------- Helpers -------------------
normalize_county <- function(x) {
x %>%
stringr::str_to_lower() %>%
stringr::str_replace_all("[[:punct:]]", " ") %>%
stringr::str_squish() %>%
stringr::str_replace_all("\\s+(county|parish|borough|census area|municipality|city and borough|city|municipio)$","") %>%
stringr::str_squish()
}
collapse_ruca3 <- function(primary_ruca) {
p <- suppressWarnings(as.numeric(primary_ruca))
dplyr::case_when(
p >= 1 & p < 4   ~ "Urban",
p >= 4 & p < 7   ~ "Suburban",
p >= 7 & p <= 10 ~ "Rural",
TRUE ~ NA_character_
)
}
# --------------- State & county FIPS ----------------
# state_fips vector (two-digit, character), preserving your input order
state_fips <- fips_codes %>%
distinct(state_name, state_code) %>%
filter(state_name %in% state_names) %>%
arrange(match(state_name, state_names)) %>%
pull(state_code)
# county_fips (5-digit) from county_names
all_counties <- fips_codes %>%
filter(state_name %in% names(county_names)) %>%
transmute(
state_name,
county_full  = county,
county_norm  = normalize_county(county),
state_fips   = state_code,      # "39"
county_fips3 = county_code      # "035"
)
want <- purrr::imap_dfr(county_names, ~ tibble(
state_name  = .y,
county_want = .x
)) %>%
mutate(county_norm = normalize_county(county_want))
county_fips <- want %>%
left_join(all_counties, by = c("state_name","county_norm")) %>%
mutate(county_fips = paste0(state_fips, county_fips3)) %>%
pull(county_fips) %>%
unique() %>%
sort()
county_fips
# --------------- Tracts (restricted to selected counties) ----------------
tracts_sel <- map_dfr(state_fips, ~ tracts(state = .x, year = acs_year, class = "sf")) %>%
sf::st_drop_geometry() %>%
transmute(
GEOID,
STATEFP,
COUNTYFP,
county_geoid = paste0(STATEFP, COUNTYFP)
) %>%
filter(county_geoid %in% county_fips) %>%
select(GEOID, county_geoid)
# --------------- ADI: pull ALL tracts in each state, compute statewise quintiles ---------------
# For each state name, get every tract in that state; compute quintiles *within that state*; keep GEOID + adiquint.
adi_lookup_by_state <- map_dfr(state_names, function(sname) {
# Pull all tracts in this state
df <- sociome::get_adi(
state           = sname,
geography       = "tract",
year            = acs_year,
keep_indicators = FALSE
) %>%
clean_names() %>%
transmute(GEOID = geoid, ADI = adi) %>%
mutate(state_fips = substr(GEOID, 1, 2))
# Compute quintiles within the state’s distribution (ignoring NA ADI)
df %>%
filter(!is.na(ADI)) %>%
group_by(state_fips) %>%
mutate(adiquint = factor(
ntile(ADI, 5),
levels = 1:5, labels = paste0("Q", 1:5), ordered = TRUE
)) %>%
ungroup() %>%
select(GEOID, ADI, adiquint)
})
tracts_sl
tracts_sel
