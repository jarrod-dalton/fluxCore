select(GEOID, ADI, adiquint)
})
# Join state-wise adiquint to only the tracts you care about (selected counties)
adi_sel <- tracts_sel %>%
left_join(adi_lookup_by_state, by = "GEOID")
adi_sel
tabyl(str_sub(adi_sel$county_geoid,1,2))
# ---- RUCA (USDA 2020 update) ----
# Download the latest RUCA tract crosswalk from USDA.
# Replace the URL below with the most recent USDA link if it changes again.
ruca_url <- "https://www.ers.usda.gov/sites/default/files/_laserfiche/DataFiles/53241/RUCA-codes-2020-tract.csv?v=52687"
# readr::read_csv can read directly from https URLs
ruca_raw <- read_csv(ruca_url, show_col_types = FALSE) %>% janitor::clean_names()
# readr::read_csv can read directly from https URLs
ruca_raw <- read_csv(ruca_url, show_col_types = FALSE) %>% janitor::clean_names()
# Inspect the column names to confirm (should contain something like 'tract2020' and 'ruca1')
names(ruca_raw)
# Adjust column references as needed (these names are typical in the new file)
ruca_sel <- ruca_raw %>%
transmute(
GEOID  = as.character(tract_fips20),  # 11-digit tract FIPS (2020)
ruca3  = collapse_ruca3(primary_ruca) # 1–10 collapsed to Urban/Suburban/Rural
# If you also want the raw code: ruca_primary = as.integer(primary_ruca)
) %>%
semi_join(tracts_sel, by = "GEOID") %>%
select(GEOID, ruca3)
counties_by_state <- split(county_fips, substr(county_fips, 1, 2))
b01001 <- purrr::map_dfr(state_fips, function(sf) {
# 3-digit county codes for this state
cnty3 <- substr(counties_by_state[[sf]], 3, 5)
tidycensus::get_acs(
geography   = "tract",
state       = sf,            # REQUIRED for tract geography
county      = cnty3,         # restrict to just your counties (faster, smaller)
table       = "B01001",
year        = acs_year,
survey      = survey,
cache_table = TRUE
)
}) %>%
dplyr::semi_join(tracts_sel, by = "GEOID") %>%
dplyr::select(GEOID, variable, estimate)
# Variable IDs for roll-ups (ACS 5-year standard)
# Male: 20-24 = 008 + 009 + 010; 25-29 = 011; ...; 85+ = 025
male_map <- list(
m20 = c("B01001_008","B01001_009","B01001_010"),
m25 = c("B01001_011"),
m30 = c("B01001_012"),
m35 = c("B01001_013"),
m40 = c("B01001_014"),
m45 = c("B01001_015"),
m50 = c("B01001_016"),
m55 = c("B01001_017"),
m60 = c("B01001_018","B01001_019"),   # 60-61, 62-64
m65 = c("B01001_020","B01001_021"),   # 65-66, 67-69
m70 = c("B01001_022"),
m75 = c("B01001_023"),
m80 = c("B01001_024"),
m85 = c("B01001_025")
)
# Female: 20-24 = 032 + 033 + 034; 25-29 = 035; ...; 85+ = 049
female_map <- list(
f20 = c("B01001_032","B01001_033","B01001_034"),
f25 = c("B01001_035"),
f30 = c("B01001_036"),
f35 = c("B01001_037"),
f40 = c("B01001_038"),
f45 = c("B01001_039"),
f50 = c("B01001_040"),
f55 = c("B01001_041"),
f60 = c("B01001_042","B01001_043"),   # 60-61, 62-64
f65 = c("B01001_044","B01001_045"),   # 65-66, 67-69
f70 = c("B01001_046"),
f75 = c("B01001_047"),
f80 = c("B01001_048"),
f85 = c("B01001_049")
)
# Helper to sum selected variables to a single column per tract
collapse_vars <- function(b01001_long, mapping) {
# mapping is a named list, e.g. list(m20 = c("B01001_008","B01001_009","B01001_010"), ...)
look <- tibble::enframe(mapping, name = "col", value = "vars") %>%  # <- name "vars"
tidyr::unnest(vars) %>%                                           # <- unnest that "vars"
dplyr::rename(variable = vars)                                     # <- rename vars -> variable
b01001_long %>%
dplyr::semi_join(look, by = "variable") %>%
dplyr::left_join(look, by = "variable") %>%
dplyr::group_by(GEOID, col) %>%
dplyr::summarise(val = sum(estimate, na.rm = TRUE), .groups = "drop") %>%
tidyr::pivot_wider(names_from = col, values_from = val, values_fill = 0) %>%
dplyr::arrange(GEOID)
}
# run
male_wide   <- collapse_vars(b01001, male_map)
female_wide <- collapse_vars(b01001, female_map)
# Join male/female age columns
age_wide <- tracts_sel %>%
select(GEOID, county_geoid) %>%
left_join(male_wide,   by = "GEOID") %>%
left_join(female_wide, by = "GEOID")
# ------------- Assemble final wide table (one row per tract) -------------
tract_wide <- age_wide %>%
left_join(adi_sel,  by = c("GEOID","county_geoid")) %>%
left_join(ruca_sel, by = "GEOID") %>%
# order columns: GEOID, county_geoid, adiquint, ruca3, m20..m85, f20..f85
relocate(ADI, adiquint, ruca3, .after = county_geoid) %>%
arrange(GEOID)
tract_wide
write_csv(tract_wide, "~/Documents/OH_FL_ADI_RUCA_and_demogs_by_age_sex.csv")
# ------------- Assemble final wide table (one row per tract) -------------
# Build a state lookup: two-digit FIPS -> two-letter abbreviation
state_abbrev_lookup <- fips_codes %>%
distinct(state_code, state) %>%
rename(state_fips = state_code, state_abbrev = state)
tract_wide <- age_wide %>%
left_join(adi_sel,  by = c("GEOID","county_geoid")) %>%
left_join(ruca_sel, by = "GEOID") %>%
# derive state FIPS and join abbreviations
mutate(state_fips = substr(GEOID, 1, 2)) %>%
left_join(state_abbrev_lookup, by = "state_fips") %>%
# reorder columns so `state` (2-letter) is first
relocate(state_abbrev, .before = GEOID) %>%
rename(state = state_abbrev) %>%
# order columns: state, GEOID, county_geoid, ADI, adiquint, ruca3, m20..m85, f20..f85
relocate(ADI, adiquint, ruca3, .after = county_geoid) %>%
arrange(GEOID)
tract_wide
write_csv(tract_wide, "~/Documents/OH_FL_ADI_RUCA_and_demogs_by_age_sex.csv")
?fread
install.packages("DiagrammeR")
library(DiagrammeR)
mm_text <- "
flowchart LR
%% =========================
%% GLOBAL STYLE & LEGEND
%% =========================
classDef lens fill:#fff,stroke:#999,stroke-dasharray: 5 5,color:#333;
classDef patient fill:#E7F6F2,stroke:#2A6355,color:#1C3B34;
classDef provider fill:#F4F0FF,stroke:#5B4B8A,color:#372E54;
classDef org fill:#FFF4EA,stroke:#9A5C00,color:#5B3700;
classDef policy fill:#FDECF3,stroke:#9B1B54,color:#5C1433;
classDef layer fill:#ffffff,stroke:#444,color:#222;
%% Equity lens annotation
LENS([Equity Lens: PROGRESS-Plus • NIMHD Framework]):::lens
%% =========================
%% ROW 1: PATIENT FACTORS
%% =========================
subgraph R1[Patient factors (phenotype, SDoH, preferences)]
direction LR
P1([Entry & Presentation
— Symptoms, severity, comorbidities
— SDoH: PROGRESS-Plus
— Prior history/biomarkers]):::patient:::layer
P2([Diagnosis Pathway
— Appraisal & help-seeking
— Tests & misclassification risk
— Diagnostic interval]):::patient:::layer
P3([Referral & Access
— Ability to attend
— Geography/transport
— Insurance/benefits]):::patient:::layer
P4([Treatment Decisions
— Goals & preferences
— Adherence capacity
— Shared decision-making]):::patient:::layer
P5([Disease Trajectories
— Archetype: indolent / relapsing / rapid
— Co-morbid influences
— Supportive care use]):::patient:::layer
P6([Outcomes
— Function, symptoms, HRQoL
— Financial toxicity, experience
— Equity gaps in benefit]):::patient:::layer
end
%% =========================
%% ROW 2: PROVIDER / TEAM
%% =========================
subgraph R2[Provider / team (clinical reasoning, workflow)]
direction LR
T1([Entry & Presentation
— Triage & initial assessment
— Phenotyping at first contact]):::provider:::layer
T2([Diagnosis Pathway
— Differential diagnosis
— Test selection & interpretation
— Safety-netting]):::provider:::layer
T3([Referral & Access
— Referral thresholds/criteria
— Hand-offs & coordination
— Telehealth options]):::provider:::layer
T4([Treatment Decisions
— Guideline application
— HTE awareness
— Care planning]):::provider:::layer
T5([Disease Trajectories
— Monitoring cadence
— Trigger points for escalation
— Rehab/palliation integration]):::provider:::layer
T6([Outcomes
— Complications, adverse events
— Patient-reported outcomes
— Clinician workload/burnout]):::provider:::layer
end
%% =========================
%% ROW 3: ORGANIZATION / SYSTEM
%% =========================
subgraph R3[Organization / system (capacity, IT, governance)]
direction LR
O1([Entry & Presentation
— Access points & scheduling
— EHR intake templates]):::org:::layer
O2([Diagnosis Pathway
— Diagnostics capacity & quality
— Turnaround time, pathways]):::org:::layer
O3([Referral & Access
— Waitlists & navigation
— Care coordination hubs
— Multidisciplinary boards]):::org:::layer
O4([Treatment Decisions
— Formularies & coverage rules
— Care bundles, navigation
— Decision support tools]):::org:::layer
O5([Disease Trajectories
— Registries & tracking
— Care management programs
— Remote monitoring]):::org:::layer
O6([Outcomes
— Utilization & cost
— Safety & quality metrics
— Equity dashboards]):::org:::layer
end
%% =========================
%% ROW 4: POLICY / ENVIRONMENT
%% =========================
subgraph R4[Policy / environment (payment, regulation, community)]
direction LR
E1([Entry & Presentation
— Public awareness
— Primary care supply]):::policy:::layer
E2([Diagnosis Pathway
— Coverage for diagnostics
— Regulatory standards]):::policy:::layer
E3([Referral & Access
— Network design & travel burden
— Telehealth reimbursement]):::policy:::layer
E4([Treatment Decisions
— Value-based payment
— Coverage with evidence
— Clinical guidelines]):::policy:::layer
E5([Disease Trajectories
— Social care integration
— Disability supports]):::policy:::layer
E6([Outcomes
— Population health targets
— Accountability & transparency]):::policy:::layer
end
%% =========================
%% LEFT→RIGHT PATHWAY LINKS
%% =========================
P1 --> P2 --> P3 --> P4 --> P5 --> P6
T1 --> T2 --> T3 --> T4 --> T5 --> T6
O1 --> O2 --> O3 --> O4 --> O5 --> O6
E1 --> E2 --> E3 --> E4 --> E5 --> E6
%% =========================
%% CROSS-ROW ALIGNMENT (same column vertical ties)
%% (dotted lines suggest alignment across levels)
linkStyle default stroke:#999,stroke-width:1
P1 -. aligns .- T1
T1 -. aligns .- O1
O1 -. aligns .- E1
P2 -. aligns .- T2
T2 -. aligns .- O2
O2 -. aligns .- E2
P3 -. aligns .- T3
T3 -. aligns .- O3
O3 -. aligns .- E3
P4 -. aligns .- T4
T4 -. aligns .- O4
O4 -. aligns .- E4
P5 -. aligns .- T5
T5 -. aligns .- O5
O5 -. aligns .- E5
P6 -. aligns .- T6
T6 -. aligns .- O6
O6 -. aligns .- E6
%% =========================
%% FEEDBACK LOOPS (Learning Health System)
%% Outcomes -> earlier layers
P6 -. feedback .-> P2
T6 -. feedback .-> T3
O6 -. feedback .-> O4
E6 -. feedback .-> E2
%% Equity lens “surrounding” annotation
LENS --- P1
LENS --- T1
LENS --- O1
LENS --- E1
"
mermaid(mm_text)
